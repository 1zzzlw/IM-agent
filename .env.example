# 复制为项目根目录 .env，填入自己的连接参数；修改后重启后端。
# 已有 .env 时保留原值，按需补充下面的 MODELS 配置。

APP__HOST=127.0.0.1
APP__PORT=9090
NACOS__ENABLED=false
REDIS__ENABLED=false

DATABASE__HOST=127.0.0.1
DATABASE__PORT=3306
DATABASE__USER=root
DATABASE__PASSWORD=
DATABASE__NAME=zzz-im-server

# 服务端默认文字模型：未单配的辅助 Agent 固定使用此默认方案。
# 用户切换对话模型不会改变辅助 Agent；基础测试只填这三项即可。
# 使用 OpenAI 兼容地址，通常以 /v1 结尾。
MODELS__DIALOGUE__PROVIDER=custom
MODELS__DIALOGUE__BASE_URL=
MODELS__DIALOGUE__MODEL=
MODELS__DIALOGUE__API_KEY=
MODELS__DIALOGUE__TEMPERATURE=1
CHAT__REPLY_TIMEOUT=120

# 专用槽位：MODEL 留空表示未启用环境覆盖。
# 记忆、提取、事件未配置时使用服务端默认方案，不继承用户的对话选择。
# 除 DIALOGUE 可被个人选择覆盖外，其余 Agent 与多模态均为服务端固定配置。
# 指定 MODEL 后，BASE_URL、API_KEY 留空时共用上面的 DIALOGUE 连接。
# 换供应方时同时填写该槽位的 BASE_URL 和 API_KEY。
# 每个槽位均支持 PROVIDER、MODEL、BASE_URL、API_KEY、TEMPERATURE。
# PROVIDER 默认为 custom；还支持 openai、deepseek、mimo、ollama:local、ollama。
MODELS__MEMORY__MODEL=
MODELS__RETRIEVAL__MODEL=
MODELS__EVENT__MODEL=

# 例如记忆使用独立模型（取消注释并填写）：
# MODELS__MEMORY__MODEL=你的记忆模型名称
# MODELS__MEMORY__BASE_URL=https://你的服务/v1
# MODELS__MEMORY__API_KEY=你的密钥
# MODELS__MEMORY__TEMPERATURE=0.3

# 多模态按需启用；不会自动拿普通文字模型代替缺失的能力。
# 同一个多模态模型具备多种能力时，可填入多个对应槽位。
MODELS__VISION__MODEL=
MODELS__IMAGE__MODEL=
MODELS__ASR__MODEL=
MODELS__TTS__MODEL=
MODELS__AUDIO_EMOTION__MODEL=

# 例如语音合成使用独立服务：
# MODELS__TTS__MODEL=你的语音模型名称
# MODELS__TTS__BASE_URL=https://你的语音服务/v1
# MODELS__TTS__API_KEY=你的语音密钥

# 语义检索可选；未配置时使用关键词召回。
EMBEDDING__NAME=
EMBEDDING__BASE_URL=
EMBEDDING__API_KEY=
RAG__PERSIST_DIR=storage/chroma
RAG__COLLECTION_NAME=person_memory

# 经现有 IM 网关访问时，开启 Nacos 并填写注册参数。
# NACOS__ENABLED=true
# NACOS__SERVER_ADDR=127.0.0.1:8848
# NACOS__REGISTER_IP=127.0.0.1
# NACOS__REGISTER_PORT=9090

# 管理员接口默认关闭；需要时自行设置随机令牌。
# IMAGENT_ADMIN_TOKEN=
